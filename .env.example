# === IP address of yourSamsung Frame TV ===
TV_IP=

# Missing or empty IMAGE_SOURCE defaults to website-screenshot. Use png-image-url for browser-free PNG downloads.
IMAGE_SOURCE=website-screenshot
# Public or signed HTTPS URL returning a complete static PNG (no resizing).
IMAGE_URL=
# HTTPS webpage URL (Playwright mode only)
CONTENT_URL=https://framethis.link/@demo/canvas

# Playwright-only viewport size — what the browser renders at (logical CSS pixels)
CONTENT_WIDTH=1920
CONTENT_HEIGHT=1080

# Output image dimensions (saved pixel size).
# Scale factor is derived as OUTPUT_WIDTH / CONTENT_WIDTH.
# OUTPUT_HEIGHT is retained for compatibility, but is not independently applied.
# Examples:
#   HD viewport → 4K output:    INPUT=1920×1080,  OUTPUT=3840×2160  → scale=2
#   4K-native content:          INPUT=3840×2160,  OUTPUT=3840×2160  → scale=1
OUTPUT_WIDTH=3840
OUTPUT_HEIGHT=2160

# === Admin UI access ===
# Deployment values explicitly supplied by Docker Compose/docker run or the
# startup shell override the corresponding .env values, including empty values.
# Without an external override, these values configure local execution too.
SERVER_PORT=33636
# Local access by default. Use HTTPS for access over a network.
# SERVER_HOST=127.0.0.1
# SERVER_TLS_CERT=/path/to/certificate.pem
# SERVER_TLS_KEY=/path/to/private-key.pem
# Required: set a unique password of at least 16 characters before starting the admin UI.
AUTH_USER=webframe
AUTH_PASS=

# === Scheduler ===
# How often to generate + upload in scheduler mode.
# Format: <number><unit> — m (minutes), h (hours), d (days)
SCHEDULE_INTERVAL=10m

# === Chromium sandbox (Playwright only) ===
# Enabled by default. Only the exact value false disables it.
# For NAS kernels without sandbox support, set false only for trusted content.
# Disabling it reduces protection against malicious pages.
CHROMIUM_SANDBOX=true

# === Playwright image cache (not used by URL mode) ===
# Persisted locally under PLAYWRIGHT_NETWORK_CACHE_DIR or output/.playwright-network-cache.
# Set TTL (seconds) to limit age; 0 means "never expire".
PLAYWRIGHT_NETWORK_CACHE_DIR=output/.playwright-network-cache
PLAYWRIGHT_NETWORK_CACHE_TTL_SECONDS=86400

DOTENV_CONFIG_QUIET=true

# UI changes are saved directly to this .env file. Manual edits take effect on restart.
# Both local and Docker use project-root .env (mounted at /app/.env in Docker).
# To choose another path, set WEB_FRAME_ENV_FILE in the process environment before startup.
# Saves write in place, with validation and queued updates.
