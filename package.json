{
  "name": "web-frame",
  "version": "1.1.0",
  "description": "Acquire webpage screenshots or PNG images and deliver them to Samsung The Frame TVs",
  "type": "module",
  "private": true,
  "author": "Robin Bakker",
  "license": "MIT",
  "main": "dist/electron/main.js",
  "scripts": {
    "test": "npm run build && node --experimental-test-module-mocks --test test/*.test.mjs",
    "build": "tsc",
    "start": "tsx src/cli.ts start",
    "once": "tsx src/cli.ts run",
    "screenshot": "tsx src/cli.ts screenshot",
    "upload": "tsx src/cli.ts upload",
    "list": "tsx src/cli.ts list",
    "cleanup": "tsx src/cli.ts cleanup",
    "scan": "tsx src/cli.ts scan",
    "serve": "tsx src/cli.ts serve",
    "scheduler": "tsx src/cli.ts scheduler",
    "generate": "tsx src/cli.ts generate",
    "test:slim": "npm run build && node scripts/verify-slim.mjs",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --win --dir",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "electron-updater": "^6.8.11",
    "samsung-frame-connect": "^0.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 120
  },
  "optionalDependencies": {
    "playwright": "^1.64.1"
  }
}
